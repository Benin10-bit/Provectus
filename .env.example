# Não copie por cima do .env existente. instalar.sh gera a senha apenas para instalação nova.
DB_USER=provectususer
DB_NAME=provectusdb
DB_PASSWORD=
# Fuso para limites de dias/semanas/meses; registros históricos permanecem UTC.
STUDY_TIMEZONE=America/Sao_Paulo
# API fora do Compose: configure DATABASE_URL ou DB_USER/DB_PASSWORD/DB_NAME/DB_HOST.
# ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8080,http://127.0.0.1:8080
